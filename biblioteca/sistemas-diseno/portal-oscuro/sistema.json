{
  "nombre": "portal-oscuro",
  "modo": "oscuro",
  "colores": {
    "fondo": "#0b0f17",
    "superficie": "rgba(255,255,255,0.03)",
    "superficieElevada": "rgba(255,255,255,0.06)",
    "linea": "rgba(255,255,255,0.08)",
    "texto": "#e5e9f0",
    "textoAtenuado": "#7f8a9c",
    "textoSuave": "#9aa6b8",
    "acento": "#6366f1",
    "acentoTexto": "#c7d2fe",
    "exito": "#34d399",
    "aviso": "#fbbf24",
    "error": "#f87171",
    "info": "#38bdf8",
    "destacado": "#f472b6"
  },
  "tipografia": {
    "titulos": "'Space Grotesk', system-ui, sans-serif",
    "cuerpo": "'Inter', system-ui, sans-serif",
    "datos": "'JetBrains Mono', ui-monospace, monospace",
    "escala": { "xs": "11px", "sm": "12px", "base": "14px", "md": "16px", "lg": "20px", "xl": "28px", "xxl": "40px" },
    "interlineado": { "cuerpo": 1.5, "titulos": 1.2 }
  },
  "espaciado": ["4px", "8px", "12px", "16px", "24px", "32px", "48px"],
  "radios": { "control": "8px", "tarjeta": "12px", "pildora": "999px" },
  "efectos": {
    "cristal": "backdrop-filter: blur(14px) saturate(160%)",
    "sombraTarjeta": "inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.25)"
  },
  "movimiento": { "rapido": "150ms ease-out", "normal": "250ms ease-out" }
}
